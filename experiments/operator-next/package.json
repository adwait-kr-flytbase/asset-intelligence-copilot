{
  "name": "fieldwork-operator-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --out-dir dist-server",
    "test:critical": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.147",
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.45",
    "ai": "7.0.143",
    "dotenv": "17.3.1",
    "hono": "4.13.13",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76",
    "@fontsource-variable/manrope": "5.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
