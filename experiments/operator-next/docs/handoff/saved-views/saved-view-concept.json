  "warning": "Operation keys, parameter binding objects and view fields are illustrative design concepts. They are not current API contracts, an executable language or proof of an implemented capability.",
  "definition": {
    "id": "VIEW-FIXTURE-INSPECTION-OVERVIEW",
    "revision": 1,
    "name": "Synthetic well inspection overview",
    "purpose": "Show latest known well situation, last N inspections and a bounded temperature-difference trend.",
    "visibility": "private",
    "owner": "CURRENT-USER-FIXTURE",
    "entityKinds": [
      "oil_well"
    ],
    "parameters": {
      "wellId": {
        "type": "entity",
        "entityKind": "oil_well",
        "required": true,
        "default": "WELL-FIXTURE"
      },
      "inspectionCount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 5
      },
      "trendWindow": {
        "type": "time-window",
        "default": {
          "mode": "relative",
          "amount": 90,
          "unit": "day",
          "timeZone": "UTC"
        }
      }
    },
    "queries": [
      {
        "id": "QUERY-FIXTURE-OVERVIEW",
        "operation": {
          "key": "asset-overview",
          "version": 1
        },
        "arguments": {
          "assetId": {
            "parameter": "wellId"
          }
        }
      },
      {
        "id": "QUERY-FIXTURE-INSPECTIONS",
        "operation": {
          "key": "asset-history",
          "version": 1
        },
        "arguments": {
          "assetId": {
            "parameter": "wellId"
          },
          "eventKinds": {
            "constant": [
              "inspection"
            ]
          },
          "limit": {
            "parameter": "inspectionCount"
          },
          "ordering": {
            "constant": "newest-first"
          }
        }
      },
      {
        "id": "QUERY-FIXTURE-TREND",
        "operation": {
          "key": "asset-analysis",
          "version": 1
        },
        "arguments": {
          "assetId": {
            "parameter": "wellId"
          },
          "analysis": {
            "constant": "temperature-difference-history"
          },
          "window": {
            "parameter": "trendWindow"
          }
        }
      }
    ],
    "panels": [
      {
        "id": "PANEL-FIXTURE-SITUATION",
        "componentKind": "asset-situation",
        "queryId": "QUERY-FIXTURE-OVERVIEW",
        "refreshMode": "deterministic"
      },
      {
        "id": "PANEL-FIXTURE-INSPECTIONS",
        "componentKind": "table",
        "queryId": "QUERY-FIXTURE-INSPECTIONS",
        "refreshMode": "deterministic",
        "columns": [
          "observedAt",
          "wellheadTemperature",
          "ambientTemperature",
          "derivedCondition"
        ],
        "description": "Last N inspections, regardless of the trend date range."
      },
      {
        "id": "PANEL-FIXTURE-TREND",
        "componentKind": "line-chart",
        "queryId": "QUERY-FIXTURE-TREND",
        "refreshMode": "deterministic",
        "description": "Temperature difference during the selected trend period."
      }
    ],
    "refreshPolicy": {
      "onOpen": true,
      "onApplyParameters": true,
      "backgroundSchedule": null
    },
    "narrativePolicy": "Do not carry a previous asset-specific AI explanation into refreshed results."
  },
