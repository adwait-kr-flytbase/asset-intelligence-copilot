{
  "name": "@repo/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env up -d --wait",
    "db:down": "docker compose --env-file .env down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check.ts",
    "db:smoke": "tsx scripts/smoke.ts",
    "db:watch": "tsup --watch --no-clean"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "dotenv": "17.3.1",
    "tsx": "4.23.15",
    "tsup": "9.0.0"
  }
}
