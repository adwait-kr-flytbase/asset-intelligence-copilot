# db:up builds PostgreSQL 18 with pgvector. Keep the same volume/URL on upgrades.
# Choose a distinct Compose project and free port per worktree.
COMPOSE_PROJECT_NAME=asset-cuskeel
DB_PORT=55432
POSTGRES_DB=asset_final_validation_20270115
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=replace-with-local-password
# Used by db:check, db:migrate and db:studio. Match the credentials and port above.
# URL-encode special password characters in this URL. Keep this file free of real secrets.
DATABASE_URL=postgresql://asset_app:replace-with-local-password@127.0.0.1:55432/asset_final_validation_20270115
