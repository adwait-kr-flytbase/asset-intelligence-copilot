# Match packages/db/.env; for a new URL run db:migrate there before ingestion.
DATABASE_URL=postgresql://asset_app:replace-with-local-password@127.0.0.1:55432/asset_final_validation_20270115
# For post-import document indexing; directory ingestion needs no API key.
OPENROUTER_API_KEY=
# Used by embed:documents, not by directory ingestion. See docs/document-embeddings.md.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
