PORT=3001
HOST=127.0.0.1
# Match packages/db/.env (or the migrated hosted database).
# Required for database-backed features; fixture mode can run without it.
DATABASE_URL=postgresql://asset_app:replace-with-local-password@127.0.0.1:55432/asset_final_validation_20270115
# OpenRouter credentials for the separate evidence agent runtime (not fixture mode).
OPENROUTER_API_KEY=
# Default development candidate; any compatible OpenRouter tool model ID is supported.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Blank specialist overrides inherit OPENROUTER_MODEL.
OPENROUTER_EVIDENCE_MODEL=
OPENROUTER_PROCEDURE_MODEL=
# Optional hosting-provider slug for reproducible runs; all role models must exist there.
# OPENROUTER_PROVIDER=deepinfra
# Optional API hybrid retrieval: uncomment to match the indexed embedding profile.
# Keep identical to the indexing profile in apps/ingestion/.env.
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_DIMENSIONS=1536

# Persistent application API (independent of fixture 3001 and agent POC 3002).
APP_PORT=3003
APP_NAMESPACE=challenge
# Set a local random secret of at least 32 characters; demo persona cookies only.
APP_SESSION_SECRET=
# Optional fixed challenge clock; omit for server time per run.
# APP_AS_OF=2026-10-17T00:00:00Z
APP_TIMEOUT_MS=120000
# Browser accesses through its same-origin Vite proxy; add exact custom origins here.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3003,http://127.0.0.1:3003
APP_AS_OF=2027-01-15T23:59:59.999Z
