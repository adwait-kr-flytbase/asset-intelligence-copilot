{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "WEB_PORT",
        "VITE_API_TARGET",
        "APP_PORT",
        "APP_NAMESPACE",
        "APP_AS_OF",
        "APP_TIMEOUT_MS",
        "APP_ALLOWED_ORIGINS"
      ],
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL", "APP_SESSION_SECRET", "OPENROUTER_*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_TARGET", "WEB_PORT"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  },
  "globalDependencies": ["tsconfig.base.json"]
}
